# Ghostty config, migrated from wezterm.lua
# Reload with ctrl+shift+, and check what was parsed with: ghostty +show-config

# --- Window ---------------------------------------------------------------
maximize = true
background-opacity = 0.8
background-blur = true
confirm-close-surface = false
window-decoration = client
gtk-titlebar-style = tabs

# --- Font -----------------------------------------------------------------
font-family = "Fira Code Nerd Font"
#font-family = "Noto Color Emoji"
#font-codepoint-map = U+2714=DejaVuSansMono

# --- Copy -----------------------------------------------------------------
# If this doesn't work, run
# `gsettings set org.gnome.desktop.interface gtk-enable-primary-paste true`
copy-on-select = true

# --- Colors ---------------------------------------------------------------
background = #000000
foreground = #b2b2b2

cursor-color = #52ad70
cursor-text = #000000
cursor-style = block
cursor-style-blink = false

selection-background = #fffacd
selection-foreground = #000000

bold-color = bright

palette = 0=#000000
palette = 1=#cc5555
palette = 2=#55cc55
palette = 3=#cdcd55
palette = 4=#5555cc
palette = 5=#cc55cc
palette = 6=#7acaca
palette = 7=#cccccc
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff

# --- Startup --------------------------------------------------------------
# initial-command = distrobox enter arch

# --- Keybinds -------------------------------------------------------------
# Font size (default)
#keybind = ctrl+-=decrease_font_size:1
#keybind = ctrl+==increase_font_size:1

# Zoom (default)
#ctrl+enter=toggle_fullscreen
#ctrl+shift+enter=toggle_split_zoom

# New tab (default)
#keybind = ctrl+shift+t=new_tab

# Move between tabs (default)
#keybind = ctrl+shift+tab=previous_tab
#keybind = ctrl+tab=next_tab
#alt+digit_1=goto_tab:1
#alt+digit_2=goto_tab:2
#alt+digit_3=goto_tab:3
#alt+digit_4=goto_tab:4
#alt+digit_5=goto_tab:5
#alt+digit_6=goto_tab:6
#alt+digit_7=goto_tab:7
#alt+digit_8=goto_tab:8
#alt+1=goto_tab:1
#alt+2=goto_tab:2
#alt+3=goto_tab:3
#alt+4=goto_tab:4
#alt+5=goto_tab:5
#alt+6=goto_tab:6
#alt+7=goto_tab:7
#alt+8=goto_tab:8
#alt+9=last_tab

# Close the current tab (default)
#keybind = ctrl+shift+w=close_tab:this

# Move between panes
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+l=goto_split:right
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+down=goto_split:down
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+right=goto_split:right

# New pane
keybind = ctrl+shift+h=new_split:left
keybind = ctrl+shift+j=new_split:down
keybind = ctrl+shift+k=new_split:up
keybind = ctrl+shift+l=new_split:right
keybind = ctrl+shift+left=new_split:left
keybind = ctrl+shift+down=new_split:down
keybind = ctrl+shift+up=new_split:up
keybind = ctrl+shift+right=new_split:right

# Next / previous pane
keybind = ctrl+alt+tab=goto_split:next
keybind = ctrl+alt+shift+tab=goto_split:previous

# Close the current pane
keybind = ctrl+alt+d=close_surface

# Clear scrollback buffer
keybind = ctrl+semicolon=clear_screen

# ctrl+backspace deletes a word (sends ctrl+w to the shell)
keybind = ctrl+backspace=text:\x17
