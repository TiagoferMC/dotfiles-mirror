# Ghostty config, migrated from wezterm.lua
# Reload with ctrl+shift+, and check what was parsed with: ghostty +show-config

# --- Window ---------------------------------------------------------------
maximize = true
background-opacity = 0.8
background-blur = true
confirm-close-surface = false
window-decoration = client
gtk-titlebar-style = tabs

# --- Font -----------------------------------------------------------------
font-family = "Fira Code Nerd Font"
#font-family = "Noto Color Emoji"
#font-codepoint-map = U+2714=DejaVuSansMono

# --- Copy -----------------------------------------------------------------
copy-on-select = true

# --- Colors ---------------------------------------------------------------
background = #000000
foreground = #b2b2b2

cursor-color = #52ad70
cursor-text = #000000
cursor-style = block
cursor-style-blink = false

selection-background = #fffacd
selection-foreground = #000000

bold-color = bright

palette = 0=#000000
palette = 1=#cc5555
palette = 2=#55cc55
palette = 3=#cdcd55
palette = 4=#5555cc
palette = 5=#cc55cc
palette = 6=#7acaca
palette = 7=#cccccc
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff

# --- Startup --------------------------------------------------------------
# initial-command = distrobox enter arch

# --- Keybinds -------------------------------------------------------------
# ctrl+backspace deletes a word (sends ctrl+w to the shell)
keybind = ctrl+backspace=text:\x17

# Split the current pane
keybind = ctrl+alt+shift+h=new_split:left
keybind = ctrl+alt+shift+j=new_split:down
keybind = ctrl+alt+shift+k=new_split:up
keybind = ctrl+alt+shift+l=new_split:right

# Move between panes
keybind = ctrl+alt+h=goto_split:left
keybind = ctrl+alt+j=goto_split:down
keybind = ctrl+alt+k=goto_split:up
keybind = ctrl+alt+l=goto_split:right

# Close current pane
keybind = ctrl+alt+d=close_surface
