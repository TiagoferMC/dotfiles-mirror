#!/bin/bash

mod1 + w
    dmenufm

XF86AudioRaiseVolume
    [ $(pamixer --get-mute) = true ] && pamixer -t ; pamixer --allow-boost -i 1

XF86AudioLowerVolume
    [ $(pamixer --get-mute) = true ] && pamixer -t ; pamixer --allow-boost -d 1

XF86AudioMute
    pamixer -t

XF86MonBrightnessDown
    xbacklight -dec 20

XF86MonBrightnessUp
    xbacklight -inc 20


mod1 + shift + r
    killall wallpaper.sh ; killall xwinwrap ; /home/tiagofer/Scripts/Wallpaper/wallpaper.sh

Print
    maim | xclip -sel clip -t image/png && notify-send Screenshot 'Screenshot Copied to Clipboard'

mod1 + Print
    LIBGL_ALWAYS_SOFTWARE=1 maim -s | xclip -sel clip -t image/png && notify-send Screenshot 'Screenshot Copied to Clipboard'

shift + Print
    maim ~/Pictures/$(date +%FZ%T).png && notify-send Screenshot 'Screenshot Saved'

mod1 + shift + Print
    LIBGL_ALWAYS_SOFTWARE=1 maim -s ~/Pictures/$(date +%FZ%T).png && notify-send Screenshot 'Screenshot Saved'

mod1 + shift + m
    kitty -e zsh -c 'flashfetch ; $SHELL'

mod1 + p
    dmenu_run

mod1 + shift + p; {t, v, l, m, d, e, s, b, p}
    {kitty -e htop, \
     kitty -e nvim, \
     kitty -e links search.brave.com, \
     musescore3, \
     armcord,  \
     element-desktop, \
     steam, \
     brave, \
     picom -b ; killall xwinwrap ; /home/tiagofer/Scripts/Wallpaper/wallpaper.sh
}

mod1 + shift + p; k; {d, p, s}
    {killall armcord, \
     killall picom, \
     killall sxhkd && setsid -f sxhkd
}

mod1 + shift + p; f; {f, v, d}
    {dmenufm, \
     kitty -e vifm, \
     dolphin
}

mod4 + @space
    /home/tiagofer/Scripts/Keyboard/KBLayout.sh
