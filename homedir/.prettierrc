printWidth: 80
tabWidth: 4
useTabs: false
semi: true
singleQuote: false
quoteProps: "as-needed"
jsxSingleQuote: true
trailingComma: "es5"
bracketSpacing: true
jsxBracketSameLine: true
arrowParens: "avoid"
requirePragma: false
insertPragma: false
proseWrap: "preserve"
htmlWhitespaceSensitivity: "css"
vueIndentScriptAndStyle: false
endOfLine: "lf"
embeddedLanguageFormatting: "auto"
