#!/bin/bash

mod1 + w
    dmenufm

XF86AudioRaiseVolume
    pactl set-sink-mute 0 false ; pactl set-sink-volume 0 +2% ; \
    pactl set-sink-mute 4 false ; pactl set-sink-volume 4 +2%

XF86AudioLowerVolume
    pactl set-sink-mute 0 false ; pactl set-sink-volume 0 -2% ; \
    pactl set-sink-mute 4 false ; pactl set-sink-volume 4 -2%

XF86AudioMute
    pactl set-sink-mute 0 toggle ; \
    pactl set-sink-mute 4 toggle

XF86MonBrightnessDown
    xbacklight -dec 20

XF86MonBrightnessUp
    xbacklight -inc 20


mod1 + shift + r
    killall xwinwrap ; /home/tiagofer/Scripts/Wallpaper/wallpaper.sh

Sys_Req
    spectacle

mod1 + shift + m
    st -e sh -c 'neofetch ; $SHELL'

mod1 + shift + p; {t, v, l, m, d, e, s}
    {st -e htop, \
     st -e nvim, \
     st -e links ddg.gg, \
     mullvad-vpn, \
     discord,  \
     element-desktop, \
     steam}

mod1 + shift + p; b; {b, c, v}
    {firefox, \
     chromium, \
     qutebrowser}

mod1 + shift + p; f; {f, v, d}
    {dmenufm, \
     st -e vifm, \
     dolphin}
