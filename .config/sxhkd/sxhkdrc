#!/bin/bash

mod1 + w
    dmenufm

XF86AudioRaiseVolume
    [ $(pamixer --get-mute) = true ] && pamixer -t ; pamixer --allow-boost -i 1

XF86AudioLowerVolume
    [ $(pamixer --get-mute) = true ] && pamixer -t ; pamixer --allow-boost -d 1

XF86AudioMute
    pamixer -t

XF86MonBrightnessDown
    xbacklight -dec 20

XF86MonBrightnessUp
    xbacklight -inc 20


mod1 + shift + r
    killall xwinwrap ; /home/tiagofer/Scripts/Wallpaper/wallpaper.sh

Sys_Req
    spectacle

mod1 + shift + m
    st -e sh -c 'cd ~ ; neofetch ; $SHELL'

mod1 + p
    dmenu_run

mod1 + shift + p; {t, v, l, m, d, e, s}
    {st -e htop, \
     st -e nvim, \
     st -e links ddg.gg, \
     mullvad-vpn, \
     discord,  \
     element-desktop, \
     steam}

mod1 + shift + p; b; {b, c, v}
    {firefox, \
     chromium, \
     qutebrowser}

mod1 + shift + p; f; {f, v, d}
    {dmenufm, \
     st -e vifm, \
     dolphin}
