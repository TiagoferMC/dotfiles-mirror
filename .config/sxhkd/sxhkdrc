#!/bin/bash

mod1 + w
    dmenufm

XF86AudioRaiseVolume
    pactl set-sink-mute 0 false ; pactl set-sink-volume 0 +2% ; \
    pactl set-sink-mute 1 false ; pactl set-sink-volume 1 +2%

XF86AudioLowerVolume
    pactl set-sink-mute 0 false ; pactl set-sink-volume 0 -2% ; \
    pactl set-sink-mute 1 false ; pactl set-sink-volume 1 -2%

XF86AudioMute
    pactl set-sink-mute 0 toggle ; \
    pactl set-sink-mute 1 toggle

mod1 + shift + r
    killall xwinwrap ; /home/tiagofer/Scripts/Wallpaper/wallpaper.sh

Sys_Req
    spectacle

mod1 + shift + m
    st -e sh -c 'neofetch ; $SHELL'

mod1 + shift + p; {b, l, t, v, f, d, s}
    {firefox, \
     st -e links ddg.gg, \
     st -e htop, \
     st -e nvim, \
     st -e vifm, \
     discord,  \
     steam}

