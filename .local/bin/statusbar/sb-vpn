#!/bin/bash

# Show 🔒 if a vpn connection is active
# Show the appropriate country flag if using a supported vpn (only mullvad at the moment)

case $BLOCK_BUTTON in
     1) mullvad-vpn ;;
     3) notify-send "🔒: vpn is active, 🔒: vpn is off, Click to open VPN Settings." ;;
     6) "$TERMINAL" -e "$EDITOR" "$0" ;;
 esac

 if [ "$(cat /sys/class/net/tun*/operstate 2>/dev/null)" ]; then
    if [ "$(tail -n 5 /var/log/mullvad-vpn/daemon.log | grep 'New tunnel state' | awk \{'print $6'\})" = 'Connected' ]; then
        country=$(tail -n 5 /var/log/mullvad-vpn/daemon.log | grep "New tunnel state" | awk -F \, \{'print $7'\} | awk -F \" \{'print $2'\})
        # city=$(tail -n 5 /var/log/mullvad-vpn/daemon.log | grep "New tunnel state" | awk -F \, \{'print $9'\} | awk -F \" \{'print $1'\} | cut -d \  -f 2)

        case $country in
            Austria) flag="\U1F1E6\U1F1F9" ;;
            Australia) flag="\U1F1E6\U1F1FA" ;;
            Belguim) flag="\U1F1E7\U1F1EA" ;;
            Brazil) flag="\U1F1E7\U1F1F7" ;;
            Bulgaria) flag="\U1F1E7\U1F1EC" ;;
            Canada) flag="\U1F1E8\U1F1E6" ;;
            "Czech Republic") flag="\U1F1E8\U1F1FF" ;;
            Denmark) flag="\U1F1E9\U1F1F0" ;;
            Finland) flag="\U1F1EB\U1F1EE" ;;
            France) flag="\U1F1EB\U1F1F7" ;;
            Germany) flag="\U1F1E9\U1F1EA" ;;
            "Hong Kong") flag="\U1F1ED\U1F1F0" ;;
            Hungary) flag="\U1F1ED\U1F1FA" ;;
            Ireland) flag="\U1F1EE\U1F1EA" ;;
            Italy) flag="\U1F1EE\U1F1F9" ;;
            Japan) flag="\U1F1EF\U1F1F5" ;;
            Latvia) flag="\U1F1F1\U1F1FB" ;;
            Luxembourg) flag="\U1F1F1\U1F1FA" ;;
            Moldova) flag="\U1F1F2\U1F1E9" ;;
            Netherlands) flag="\U1F1F3\U1F1F1" ;;
            "New Zealand") flag="\U1F1F3\U1F1FF" ;;
            Norway) flag="\U1F1F3\U1F1F4" ;;
            Poland) flag="\U1F1EF5\U1F1F1" ;;
            Portugal) flag="\U1F1F5\U1F1F9" ;;
            Romania) flag="\U1F1F7\U1F1F4" ;;
            Serbia) flag="\U1F1F7\U1F1F8" ;;
            Singapore) flag="\U1F1F8\U1F1EC" ;;
            Spain) flag="\U1F1EA\U1F1F8" ;;
            Sweden) flag="\U1F1F8\U1F1EA" ;;
            Switzerland) flag="\U1F1E8\U1F1ED" ;;
            UK) flag="\U1F1EC\U1F1E7" ;;
            USA) flag="\U1F1FA\U1F1F8" ;;
         esac

         # vpn="🔒 $flag"
         vpn="🔒"
     else
         vpn="🔒"
     fi
 else
     vpn="🔓"
 fi

 printf "$vpn"
